          "rawQuery": true,
          "rawSql": "SELECT\n  dst_endpoint.ip as dst_endpoint_ip,\n  dst_endpoint.port as dst_endpoint_port,\n  connection_info.protocol_name as connection_info_protocol_name,\n  activity_name,\n  count(*) as connection_count\nFROM network_activity\nWHERE time >= now() - INTERVAL 48 HOUR\n  AND (src_endpoint.ip = '172.16.1.125' OR src_endpoint.ip IS NULL)\nGROUP BY dst_endpoint.ip, dst_endpoint.port, connection_info.protocol_name, activity_name\nORDER BY count(*) DESC\nLIMIT 15",
