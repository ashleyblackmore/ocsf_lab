          "format": 0,
          "rawQuery": true,
          "rawSql": "SELECT time, source, events\nFROM (\n  SELECT\n    toStartOfMinute(time) as time,\n    'Network' as source,\n    count(*) as events\n  FROM network_activity\n  WHERE time >= now() - INTERVAL 24 HOUR\n  GROUP BY time\n  UNION ALL\n  SELECT\n    toStartOfMinute(time) as time,\n    'HTTP' as source,\n    count(*) as events\n  FROM http_activity\n  WHERE time >= now() - INTERVAL 24 HOUR\n  GROUP BY time\n  UNION ALL\n  SELECT\n    toStartOfMinute(time) as time,\n    'SSH' as source,\n    count(*) as events\n  FROM ssh_activity\n  WHERE time >= now() - INTERVAL 24 HOUR\n  GROUP BY time\n)\nORDER BY time ASC, source ASC",
