          "editorMode": "code",
          "format": 2,
          "rawQuery": true,
          "rawSql": "SELECT\n  src_endpoint.ip as source_ip,\n  'High Connection Rate' as anomaly_type,\n  count(*) as connection_count,\n  'Network' as source_table\nFROM network_activity\nWHERE time >= now() - INTERVAL 24 HOUR\n  AND src_endpoint.ip IS NOT NULL\nGROUP BY src_endpoint.ip\nHAVING count(*) > 50\nUNION ALL\nSELECT\n  src_endpoint.ip as source_ip,\n  'Multiple SSH Attempts' as anomaly_type,\n  count(*) as connection_count,\n  'SSH' as source_table\nFROM ssh_activity\nWHERE time >= now() - INTERVAL 24 HOUR\n  AND src_endpoint.ip IS NOT NULL\n  AND severity IN ('Medium', 'High')\nGROUP BY src_endpoint.ip\nHAVING count(*) > 5\nUNION ALL\nSELECT\n  src_endpoint.ip as source_ip,\n  'HTTP Scanning' as anomaly_type,\n  count(*) as connection_count,\n  'HTTP' as source_table\nFROM http_activity\nWHERE time >= now() - INTERVAL 24 HOUR\n  AND src_endpoint.ip IS NOT NULL\nGROUP BY src_endpoint.ip\nHAVING count(*) > 20\nORDER BY connection_count DESC\nLIMIT 15",
          "refId": "A",
          "sql": {
            "columns": [
              {"parameters": [], "type": "function"}
            ],
            "groupBy": [
              {"property": {"type": "string"}, "type": "groupBy"}
