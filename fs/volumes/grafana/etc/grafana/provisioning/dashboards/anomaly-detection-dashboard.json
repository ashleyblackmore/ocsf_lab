          "editorMode": "code",
          "format": 2,
          "rawQuery": true,
          "rawSql": "SELECT\n  'High Severity Events' as category,\n  count(*) as count,\n  'SSH' as source\nFROM ssh_activity\nWHERE time >= now() - INTERVAL 24 HOUR\n  AND severity IN ('Medium', 'High')\nUNION ALL\nSELECT\n  'Failed Connections' as category,\n  count(*) as count,\n  'Network' as source\nFROM network_activity\nWHERE time >= now() - INTERVAL 24 HOUR\n  AND status IN ('Failure', 'Reset', 'Refuse')\nUNION ALL\nSELECT\n  'Suspicious HTTP Methods' as category,\n  count(*) as count,\n  'HTTP' as source\nFROM http_activity\nWHERE time >= now() - INTERVAL 24 HOUR\n  AND activity_name IN ('POST', 'PUT', 'DELETE', 'CONNECT')\nUNION ALL\nSELECT\n  'RDP Connections' as category,\n  count(*) as count,\n  'RDP' as source\nFROM rdp_activity\nWHERE time >= now() - INTERVAL 24 HOUR\nORDER BY count DESC",
