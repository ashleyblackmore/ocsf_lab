          "editorMode": "code",
          "format": 2,
          "rawQuery": true,
          "rawSql": "SELECT\n  src_endpoint.ip as source_ip,\n  dst_endpoint.ip as target_ip,\n  'Multiple Protocol Activity' as anomaly_description,\n  count(*) as event_count,\n  groupArray(activity_name) as activities,\n  time\nFROM (\n  SELECT src_endpoint.ip, dst_endpoint.ip, activity_name, time FROM network_activity WHERE time >= now() - INTERVAL 24 HOUR\n  UNION ALL\n  SELECT src_endpoint.ip, dst_endpoint.ip, activity_name, time FROM http_activity WHERE time >= now() - INTERVAL 24 HOUR\n  UNION ALL\n  SELECT src_endpoint.ip, dst_endpoint.ip, activity_name, time FROM ssh_activity WHERE time >= now() - INTERVAL 24 HOUR\n  UNION ALL\n  SELECT src_endpoint.ip, dst_endpoint.ip, activity_name, time FROM rdp_activity WHERE time >= now() - INTERVAL 24 HOUR\n) combined_events\nWHERE src_endpoint.ip IS NOT NULL AND dst_endpoint.ip IS NOT NULL\nGROUP BY src_endpoint.ip, dst_endpoint.ip, time\nHAVING count(*) > 3\nORDER BY event_count DESC, time DESC\nLIMIT 20",
          "refId": "A",
