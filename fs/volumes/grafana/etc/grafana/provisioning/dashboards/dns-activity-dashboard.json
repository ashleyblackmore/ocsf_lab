          "editorMode": "code",
          "format": 0,
          "rawQuery": true,
          "rawSql": "SELECT time, query_type, count\nFROM (\n  SELECT\n    toStartOfMinute(time) as time,\n    'DNS Queries' as query_type,\n    count(*) as count\n  FROM dns_activity\n  WHERE time >= now() - INTERVAL 24 HOUR\n  GROUP BY time\n  UNION ALL\n  SELECT\n    toStartOfMinute(time) as time,\n    'Failed Queries' as query_type,\n    count(*) as count\n  FROM dns_activity\n  WHERE time >= now() - INTERVAL 24 HOUR\n    AND status = 'Failure'\n  GROUP BY time\n  UNION ALL\n  SELECT\n    toStartOfMinute(time) as time,\n    'NXDOMAIN Responses' as query_type,\n    count(*) as count\n  FROM dns_activity\n  WHERE time >= now() - INTERVAL 24 HOUR\n    AND rcode = 'NXDOMAIN'\n  GROUP BY time\n)\nORDER BY time ASC, query_type ASC",
          "refId": "A",
