          "rawSql": "SELECT\n  'Total DNS Queries' as metric,\n  toString(count(*)) as count,\n  'All DNS Activity' as category\nFROM dns_activity\nWHERE time >= now() - INTERVAL 24 HOUR\nUNION ALL\nSELECT\n  'Failed Queries' as metric,\n  toString(count(*)) as count,\n  'Error Responses' as category\nFROM dns_activity\nWHERE time >= now() - INTERVAL 24 HOUR\n  AND status = 'Failure'\nUNION ALL\nSELECT\n  'NXDOMAIN Responses' as metric,\n  toString(count(*)) as count,\n  'Non-existent Domains' as category\nFROM dns_activity\nWHERE time >= now() - INTERVAL 24 HOUR\n  AND rcode = 'NXDOMAIN'\nUNION ALL\nSELECT\n  'Unique Domains' as metric,\n  toString(count(DISTINCT query.hostname)) as count,\n  'Domain Diversity' as category\nFROM dns_activity\nWHERE time >= now() - INTERVAL 24 HOUR\n  AND query.hostname IS NOT NULL\nORDER BY count DESC",
